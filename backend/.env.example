API_TITLE=Image-to-Video Chatbot
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRE_HOURS=24
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_to_video_chatbot
SVD_MODEL_ID=stabilityai/stable-video-diffusion-img2vid-xt
SVD_DEVICE=cuda
SVD_NUM_FRAMES=25
SVD_FPS=7
SVD_DECODE_CHUNK_SIZE=8
GENERATED_MEDIA_DIR=/absolute/path/to/backend/generated
PUBLIC_BASE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
DEFAULT_VIDEO_PROVIDER=svd
MAX_VIDEO_DURATION=10
REQUEST_TIMEOUT=300
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500"]
